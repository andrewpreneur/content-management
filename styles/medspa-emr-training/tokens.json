{
  "version": "1.0.0",
  "name": "MedSpa EMR training",
  "color": {
    "accent": "#2563eb",
    "accentInk": "#1d4ed8",
    "accentSoft": "#e8f0fe",
    "ink": "#0f172a",
    "ink2": "#566173",
    "ink3": "#8a94a6",
    "panel": "#ffffff",
    "background": "#f3f6fb",
    "line": "#e3e8f0",
    "success": "#10b981",
    "warning": "#f59e0b",
    "brandSky": "#73bcdd",
    "brandDeep": "#63b7dc",
    "brandLight": "#d9eef8",
    "brandOnSky": "#ffffff",
    "scrim": "rgba(15, 23, 42, .45)"
  },
  "type": {
    "family": "'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "fontFiles": [
      "DM Sans (variable, latin) — brand/fonts/dm-sans-latin.woff2"
    ],
    "stepCount": {
      "size": 11,
      "weight": 600,
      "letterSpacing": "0.05em",
      "transform": "uppercase",
      "color": "accentInk"
    },
    "title": {
      "size": 18,
      "weight": 600,
      "lineHeight": 1.3
    },
    "titleCompact": {
      "size": 16,
      "weight": 600,
      "lineHeight": 1.3
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.5,
      "color": "ink2"
    },
    "caption": {
      "size": 28,
      "weight": 600,
      "lineHeight": 1.25
    },
    "cardTitle": {
      "size": 56,
      "weight": 600,
      "lineHeight": 1.1,
      "letterSpacing": "-0.02em"
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 40
  },
  "radius": {
    "card": 18,
    "spot": 14,
    "button": 10,
    "pill": 999
  },
  "shadow": {
    "card": "0 24px 60px -16px rgba(15, 30, 60, .5)"
  },
  "highlight": {
    "padding": 6,
    "radius": 14,
    "ring": "0 0 0 2px #2563eb",
    "halo": "0 0 0 7px rgba(37, 99, 235, .22)",
    "dim": "rgba(15, 23, 42, .45)",
    "arrow": {
      "color": "#2563eb",
      "stroke": 4,
      "length": 56
    },
    "badge": {
      "size": 28,
      "background": "#2563eb",
      "color": "#ffffff",
      "font": 14
    },
    "motion": "320ms cubic-bezier(.16,1,.3,1)"
  },
  "caption": {
    "position": "bottom-center, 64px above the bottom edge (desktop) / 120px (phone, clears the home bar)",
    "maxWidthPct": 80,
    "background": "rgba(15, 23, 42, .82)",
    "color": "#ffffff",
    "radius": 12,
    "paddingX": 20,
    "paddingY": 10,
    "maxLines": 2,
    "maxCharsPerLine": 42
  },
  "card": {
    "intro": {
      "durationSec": 3,
      "background": "linear-gradient(135deg, #73bcdd 0%, #2563eb 100%)",
      "layout": "logo 96px centred above the feature name (cardTitle, white), one-line promise below (body 24px, white 85%)"
    },
    "outro": {
      "durationSec": 3,
      "background": "#ffffff",
      "layout": "logo 72px, \"You’re all set.\" (cardTitle, ink), the menu path to the feature (body 24px, ink2), \"Questions? Support & chat in the menu.\""
    },
    "lowerThird": "step count pill (stepCount style on accentSoft) + step title (titleCompact) on panel, radius 18, shadow card"
  },
  "video": {
    "desktop": {
      "width": 1920,
      "height": 1080,
      "aspect": "16:9",
      "orientation": "horizontal",
      "captureAt": "1440x900 @2x, scaled to fit",
      "safeArea": {
        "top": 54,
        "right": 96,
        "bottom": 54,
        "left": 96
      },
      "captionSafe": "captions sit in the bottom 160px, inside the side margins"
    },
    "mobile": {
      "width": 1080,
      "height": 1920,
      "aspect": "9:16",
      "orientation": "vertical",
      "captureAt": "390x844 @3x, centred in a phone frame",
      "safeArea": {
        "top": 220,
        "right": 60,
        "bottom": 380,
        "left": 60
      },
      "captionSafe": "captions sit just above the bottom safe line (y ≈ 1400–1540)"
    },
    "lengthSec": {
      "min": 30,
      "max": 90
    },
    "fps": 30,
    "music": "Light, no vocals, −24 LUFS under the voice; none under the outro card after the first second",
    "voice": "One calm, friendly voice; second person (\"you\"); present tense; no jargon; never name the CRM vendor — say \"your CRM\"",
    "cursor": "Visible, 1.25× size, click ripple in accent; zoom 1.4× on the target for each click step"
  }
}
